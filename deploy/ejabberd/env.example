# Merge into an isolated environment file OUTSIDE the repository. Never commit values.
# This branch has one chat transport: ejabberd. Configure it before starting the API.
EJABBERD_SOURCE_ROOT=/absolute/checkout/mushroom
EJABBERD_IMAGE=mushroom-ejabberd:26.09-consultation
EJABBERD_DOMAIN=chat.example.invalid
EJABBERD_WEBSOCKET_URL=wss://api.example.invalid/xmpp-websocket
EJABBERD_SQL_HOST=postgres
EJABBERD_SQL_DB=mushroom_chat
EJABBERD_SQL_USER=mushroom_chat
EJABBERD_SQL_PASSWORD=
EJABBERD_POLICY_SECRET=
EJABBERD_PRIVATE_KEY_PATH=/absolute/private/secrets/ejabberd-private.pem
EJABBERD_PUBLIC_KEY_PATH=/absolute/private/secrets/ejabberd-public.jwk
EJABBERD_API_INTERNAL_PORT=3003
EJABBERD_PROXY_PORT=5444
EJABBERD_MEMORY_LIMIT=512m
EJABBERD_CPUS=0.50
